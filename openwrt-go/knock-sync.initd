#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG="/usr/bin/knock-sync"
CONFIG="/etc/knock-sync.json"
ENV_FILE="/etc/knock.env"

start_service() {
	[ -x "$PROG" ] || return 1
	if [ ! -f "$CONFIG" ] && [ ! -f "$ENV_FILE" ]; then
		echo "knock-sync: missing $CONFIG and $ENV_FILE" >&2
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" -config "$CONFIG"
	procd_set_param respawn 5 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	restart
}

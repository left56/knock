# Copy to .env for local runs, or to /etc/knock.env on OpenWrt.
# Real values must not be committed.

# Worker origin, no path and no trailing slash.
WORKER_BASE_URL=

# Group key. Sent as the X-Router-Secret header and must match the client's ?key=
SHARED_SECRET_ROUTER=

# Optional, OpenWrt shell client only.
# IPSET_V4_NAME=knock_ipv4
# IPSET_V6_NAME=knock_ipv6
# LOG_FILE=/var/log/http_knock_openwrt.log
# LONG_POLL_TIMEOUT_SEC=65
# RETRY_WAIT_SEC=5
# LOCK_DIR=/var/run/openwrt-http-knock.lock
